{
  "name": "perfume",
  "version": "1.0.0",
  "description": "Web performance library for measuring all User-centric performance metrics, including the latest Web Vitals.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "typings": "dist/types/index.d.mts",
  "files": [
    "dist"
  ],
  "author": "Leonardo Zizzamia",
  "repository": {
    "type": "git",
    "url": "https://github.com/Zizzamia/perfume.js.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "lint": "eslint -c .eslintrc.js --ext .ts src",
    "prebuild": "rimraf dist",
    "build": "tsdown",
    "start": "tsdown -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "coveralls": "^3.1.1",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^65.3.15",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "rimraf": "3.0.2",
    "ts-jest": "^29.4.15",
    "tsdown": "^0.23.1",
    "typescript": "^6"
  },
  "keywords": [
    "performance",
    "performance-metrics",
    "metrics",
    "navigation-timing",
    "time-to-first-byte",
    "ttfb",
    "navigator-interface",
