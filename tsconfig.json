{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["es2015", "es2016", "es2017", "dom"],
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "typeRoots": ["node_modules/@types", "./types"]
  },
  "include": ["src"]
}
